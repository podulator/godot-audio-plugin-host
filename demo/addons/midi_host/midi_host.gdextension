[configuration]

entry_symbol = "midi_host_library_init"
compatibility_minimum = "4.5"

[libraries]

linux.debug.x86_64 = "res://addons/midi_host/bin/libmidi_host.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/midi_host/bin/libmidi_host.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/midi_host/bin/libmidi_host.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/midi_host/bin/libmidi_host.windows.template_release.x86_64.dll"
macos.debug = "res://addons/midi_host/bin/libmidi_host.macos.template_debug.framework"
macos.release = "res://addons/midi_host/bin/libmidi_host.macos.template_release.framework"
android.debug.arm64 = "res://addons/midi_host/bin/libmidi_host.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/midi_host/bin/libmidi_host.android.template_release.arm64.so"
android.debug.x86_64 = "res://addons/midi_host/bin/libmidi_host.android.template_debug.x86_64.so"
android.release.x86_64 = "res://addons/midi_host/bin/libmidi_host.android.template_release.x86_64.so"

[configuration]

entry_symbol = "vst3_host_library_init"
compatibility_minimum = "4.5"

[libraries]

linux.debug.x86_64 = "res://addons/vst3_host/bin/libvst3_host.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/vst3_host/bin/libvst3_host.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/vst3_host/bin/libvst3_host.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/vst3_host/bin/libvst3_host.windows.template_release.x86_64.dll"
macos.debug = "res://addons/vst3_host/bin/libvst3_host.macos.template_debug.framework"
macos.release = "res://addons/vst3_host/bin/libvst3_host.macos.template_release.framework"
